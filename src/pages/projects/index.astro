---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getProjects } from '../../lib/projects';

// Businesses first, then projects, each by `order` (see getProjects).
// Each card still carries its Business / Project label.
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Businesses and projects by Ethan Matlack: an electrical contracting company, a self-hosted homelab, and web builds on Cloudflare."
>
  <div class="wrap">
    <header class="intro">
      <h1>Projects &amp; businesses</h1>
      <p class="lede prose-width">
        What I've built and what I run, from a licensed electrical contracting business to the
        servers and websites I keep running on the side.
      </p>
    </header>

    <section aria-label="All projects" class="all">
      <ProjectGrid projects={projects} headingLevel="h2" />
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-xl) var(--space-l);
  }
  h1 {
    font-size: var(--step-3);
    margin-block: 0 var(--space-s);
  }
  .lede {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .all {
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }
</style>
