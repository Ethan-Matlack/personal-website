---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const businesses = projects.filter((p) => p.data.kind === 'business');
const others = projects.filter((p) => p.data.kind === 'project');
---

<BaseLayout
  title="Projects"
  description="Businesses and projects by Ethan Matlack: an electrical contracting company, a self-hosted homelab, and web builds on Cloudflare."
>
  <div class="wrap">
    <header class="intro">
      <p class="label">Index</p>
      <h1>Projects &amp; businesses</h1>
      <p class="lede prose-width">
        What I've built and what I run, from a licensed electrical contracting business to the
        servers and websites I keep running on the side.
      </p>
    </header>

    {businesses.length > 0 && (
      <section aria-labelledby="businesses">
        <SectionHeading index="01" id="businesses" title="Businesses" />
        <ProjectGrid projects={businesses} />
      </section>
    )}
    {others.length > 0 && (
      <section aria-labelledby="projects">
        <SectionHeading index="02" id="projects" title="Projects" />
        <ProjectGrid projects={others} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-xl) var(--space-l);
  }
  h1 {
    font-size: var(--step-3);
    margin-block: var(--space-2xs) var(--space-s);
  }
  .lede {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  section + section {
    margin-top: var(--space-xl);
  }
</style>
