---
import BaseLayout from '../layouts/BaseLayout.astro';
import DateRange from '../components/DateRange.astro';
import CredentialList from '../components/CredentialList.astro';
import { resume } from '../lib/resume';
import CertificationGroups from '../components/CertificationGroups.astro';
import { site } from '../data/site';

const { basics, highlights, experience, education, licenses, skills } = resume;
const display = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="Resume"
  description="Experience, education, licenses, and certifications for controls, automation, and electrical work. Read it here or download the PDF."
>
  <article class="wrap resume">
    <header class="top">
      <div class="id">
        <h1>{basics.name}</h1>
        <p class="headline">{basics.headline}</p>
        <ul class="contact" role="list">
          <li>{site.location}</li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={site.socials.linkedin} target="_blank" rel="me noopener">
              <span class="screen-only">LinkedIn</span>
              <span class="print-only">{display(site.socials.linkedin)}</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={site.socials.github} target="_blank" rel="me noopener">
              <span class="screen-only">GitHub</span>
              <span class="print-only">{display(site.socials.github)}</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li class="print-only">{display(site.url)}</li>
        </ul>
      </div>
      <div class="actions no-print">
        <a class="text-button" data-primary href="/ethan-matlack-resume.pdf" download>
          Download PDF{' '}
          <span class="arrow" aria-hidden="true">
            ↓
          </span>
        </a>
        <p class="hint label">Or print this page. It's formatted for Letter paper.</p>
      </div>
    </header>

    <section class="block" aria-labelledby="r-summary">
      <h2 id="r-summary" class="label">
        Summary
      </h2>
      <div class="content">
        <p class="summary">{basics.summary}</p>
        {highlights.length > 0 && (
          <ul class="highlights" role="list">
            {highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="block" aria-labelledby="r-experience">
      <h2 id="r-experience" class="label">
        Experience
      </h2>
      <div class="content">
        {experience.map((job) => (
          <article class="entry">
            <header class="entry-head">
              <h3>
                {job.role}
                <span class="org">, {job.org}</span>
              </h3>
              <p class="when label">
                <DateRange start={job.start} end={job.end} />
                {job.location && <span class="loc"> · {job.location}</span>}
              </p>
            </header>
            <ul class="bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-education">
      <h2 id="r-education" class="label">
        Education
      </h2>
      <div class="content">
        {education.map((e) => (
          <article class="entry">
            <header class="entry-head">
              <h3>
                {e.degree}
                <span class="org">, {e.school}</span>
              </h3>
              <p class="when label">
                <DateRange start={e.start} end={e.end} />
              </p>
            </header>
            {e.bullets.length > 0 && (
              <ul class="bullets">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-licenses">
      <h2 id="r-licenses" class="label">
        Licenses
      </h2>
      <div class="content">
        <CredentialList items={licenses} label="Licenses" />
      </div>
    </section>

    <section class="block" aria-labelledby="r-certs">
      <h2 id="r-certs" class="label">
        Certifications
      </h2>
      <div class="content">
        <CertificationGroups />
      </div>
    </section>

    <section class="block" aria-labelledby="r-skills">
      <h2 id="r-skills" class="label">
        Skills
      </h2>
      <div class="content">
        <div class="skills">
          {skills.map((s) => (
            <div class="skill-group">
              <h3 class="group-head">{s.group}</h3>
              <ul class="chips skill-chips" role="list">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .resume {
    max-width: calc(62rem + var(--gutter) * 2);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    padding-block: var(--space-xl) var(--space-l);
  }
  h1 {
    font-size: var(--step-3);
  }
  .headline {
    font-size: var(--step-1);
    color: var(--muted);
    margin-top: var(--space-3xs);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }
  .hint {
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .block {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-m);
    border-top: 2px solid var(--accent);
  }
  @media (max-width: 40rem) {
    .block {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
  .block > h2 {
    padding-top: 0.3em;
    color: var(--accent);
    font-weight: 600;
  }
  .content {
    min-width: 0;
  }
  .summary {
    max-width: var(--measure);
  }
  .highlights {
    margin-top: var(--space-s);
    display: grid;
    gap: 0.35rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.1rem;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--lamp);
    border-radius: 50%;
  }

  .entry + .entry {
    margin-top: var(--space-m);
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-s);
  }
  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .org {
    font-weight: 400;
    color: var(--muted);
  }
  .when {
    white-space: nowrap;
  }
  .bullets {
    margin-top: var(--space-2xs);
    padding-left: 1.1em;
  }
  .bullets li + li {
    margin-top: 0.3em;
  }
  .bullets li::marker {
    color: var(--muted);
  }

  /* The section already has a top rule; don't double it on the first row. */
  .content > :global(.cred-list:first-child > .cred-row:first-child) {
    border-top: 0;
    padding-top: 0.15rem;
  }
  /* Group heads match the certification groups (CertificationGroups.astro). */
  .skill-group + .skill-group {
    margin-top: var(--space-m);
  }
  .group-head {
    padding-bottom: 0.45rem;
    margin-bottom: var(--space-xs);
    border-bottom: 2px solid var(--text);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .skill-chips li {
    font-family: var(--font-body);
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--text);
    border-color: var(--rule-strong);
    padding: 0.25em 0.75em;
  }

  .print-only {
    display: none;
  }
</style>
