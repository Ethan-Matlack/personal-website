---
import BaseLayout from '../layouts/BaseLayout.astro';
import DateRange from '../components/DateRange.astro';
import { resume } from '../lib/resume';
import { site } from '../data/site';

const { basics, highlights, experience, education, licenses, certifications, skills } = resume;
const display = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="Resume"
  description={`Resume of ${basics.name}: ${basics.headline.toLowerCase()} focused on industrial controls, electrical systems, and automation. Based in ${site.location}.`}
>
  <article class="wrap resume">
    <header class="top">
      <div class="id">
        <h1>{basics.name}</h1>
        <p class="headline">{basics.headline}</p>
        <ul class="contact" role="list">
          <li>{site.location}</li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={site.socials.linkedin} rel="me noopener">
              <span class="screen-only">LinkedIn</span>
              <span class="print-only">{display(site.socials.linkedin)}</span>
            </a>
          </li>
          <li>
            <a href={site.socials.github} rel="me noopener">
              <span class="screen-only">GitHub</span>
              <span class="print-only">{display(site.socials.github)}</span>
            </a>
          </li>
          <li class="print-only">{display(site.url)}</li>
        </ul>
      </div>
      <div class="actions no-print">
        <a class="text-button" data-primary href="/ethan-matlack-resume.pdf" download>
          Download PDF{' '}
          <span class="arrow" aria-hidden="true">
            ↓
          </span>
        </a>
        <p class="hint label">Or print this page. It's formatted for Letter paper.</p>
      </div>
    </header>

    <section class="block" aria-labelledby="r-summary">
      <h2 id="r-summary" class="label">
        Summary
      </h2>
      <div class="content">
        <p class="summary">{basics.summary}</p>
        {highlights.length > 0 && (
          <ul class="highlights" role="list">
            {highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="block" aria-labelledby="r-experience">
      <h2 id="r-experience" class="label">
        Experience
      </h2>
      <div class="content">
        {experience.map((job) => (
          <article class="entry">
            <header class="entry-head">
              <h3>
                {job.role}
                <span class="org">, {job.org}</span>
              </h3>
              <p class="when label">
                <DateRange start={job.start} end={job.end} />
                {job.location && <span class="loc"> · {job.location}</span>}
              </p>
            </header>
            <ul class="bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-education">
      <h2 id="r-education" class="label">
        Education
      </h2>
      <div class="content">
        {education.map((e) => (
          <div class="entry">
            <div class="entry-head">
              <h3>
                {e.degree}
                <span class="org">, {e.school}</span>
              </h3>
              {e.year && <p class="when label">{e.year}</p>}
            </div>
            {e.focus && <p class="detail">Focus: {e.focus}</p>}
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-licenses">
      <h2 id="r-licenses" class="label">
        Licenses
      </h2>
      <div class="content">
        <ul class="rows" role="list">
          {licenses.map((l) => (
            <li>
              <span class="name">{l.name}</span>
              <span class="meta">
                {l.issuer}
                {l.year && <>, {l.year}</>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" aria-labelledby="r-certs">
      <h2 id="r-certs" class="label">
        Certifications
      </h2>
      <div class="content">
        <ul class="inline-list" role="list">
          {certifications.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" aria-labelledby="r-skills">
      <h2 id="r-skills" class="label">
        Skills
      </h2>
      <div class="content">
        <dl class="skills">
          {skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .resume {
    max-width: calc(48rem + var(--gutter) * 2);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    padding-block: var(--space-xl) var(--space-l);
  }
  h1 {
    font-size: var(--step-3);
  }
  .headline {
    font-size: var(--step-1);
    color: var(--muted);
    margin-top: var(--space-3xs);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }
  .hint {
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .block {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-m);
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 40rem) {
    .block {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
  .block > h2 {
    padding-top: 0.3em;
  }
  .content {
    min-width: 0;
  }
  .summary {
    max-width: var(--measure);
  }
  .highlights {
    margin-top: var(--space-s);
    display: grid;
    gap: 0.35rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.1rem;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--lamp);
    border-radius: 50%;
  }

  .entry + .entry {
    margin-top: var(--space-m);
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-s);
  }
  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .org {
    font-weight: 400;
    color: var(--muted);
  }
  .when {
    white-space: nowrap;
  }
  .bullets {
    margin-top: var(--space-2xs);
    padding-left: 1.1em;
  }
  .bullets li + li {
    margin-top: 0.3em;
  }
  .bullets li::marker {
    color: var(--muted);
  }
  .detail {
    color: var(--muted);
  }

  .rows li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-s);
  }
  .rows li + li {
    margin-top: 0.35rem;
  }
  .name {
    font-weight: 500;
  }
  .meta {
    color: var(--muted);
  }
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
  }
  .inline-list li:not(:last-child)::after {
    content: '·';
    color: var(--muted);
    margin-inline: 0.6em;
  }
  .skills > div {
    display: grid;
    grid-template-columns: minmax(0, 12rem) 1fr;
    gap: var(--space-s);
  }
  @media (max-width: 40rem) {
    .skills > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .skills > div + div {
    margin-top: 0.5rem;
  }
  .skills dt {
    font-weight: 500;
  }
  .skills dd {
    color: var(--muted);
  }

  .print-only {
    display: none;
  }
</style>
