---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Credentials from '../components/Credentials.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site';
import { resume } from '../lib/resume';
import { getProjects } from '../lib/projects';

const featured = (await getProjects()).filter((p) => p.data.featured);

// TODO: add a portrait?? (drop into src/assets/)
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp}',
  { eager: true },
);
const portrait = Object.values(portraitModules)[0]?.default;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.headline,
  url: site.url,
  sameAs: [site.socials.linkedin, site.socials.github, 'https://matlackelectric.com'],
  alumniOf: resume.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  address: { '@type': 'PostalAddress', addressLocality: site.location },
};
---

<BaseLayout
  description={`Hi, I'm Ethan. I work where engineering meets the trades: industrial controls, electrical systems, and the software in between. Based in ${site.location}.`}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class:list={['hero', { 'has-portrait': portrait }]} aria-labelledby="hero-name">
      <div class="hero-text">
        <p class="label loc">
          <span class="lamp" aria-hidden="true"></span>
          {site.location}
        </p>
        <h1 id="hero-name">{site.name}</h1>
        <p class="headline">{site.headline}</p>
        <p class="actions">
          <a class="text-button" data-primary href="/resume/">
            View resume{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="text-button" href="/projects/">
            See projects{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      </div>
      {portrait && (
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[320, 640]}
          sizes="(min-width: 60rem) 20rem, 60vw"
          class="portrait"
          loading="eager"
          fetchpriority="high"
        />
      )}
    </section>

    <section class="section" aria-labelledby="about">
      <SectionHeading index="01" id="about" title="About" />
      <div class="prose about">
        <p>
          Hi! I'm a robotics engineer and licensed master electrician. I received my B.S. in
          Robotics Engineering from Widener University in 2023, where I led a{' '}
          <a href="/projects/drone-autocharging/">senior capstone</a> building a self-landing,
          self-charging drone that won Best Oral Presentation.
        </p>
        <p>
          In 2020, while still in school, I started{' '}
          <a href="/projects/matlack-electric/">Matlack Electric</a>, a licensed electrical
          contracting business in Pennsylvania, and I've run it full-time since graduating. I've
          since moved the business, and myself, to Tennessee. I've learned a lot about running a
          small business and the ins and outs of all things electrical, from troubleshooting systems
          with no documentation to taking a job from estimate through inspection. That's made me a
          better engineer and problem-solver.
        </p>
        <p>
          While I enjoy the hands-on nature of electrical contracting, I'm eager to get back into
          engineering and controls work, which is where my passion lies. I'm currently looking for a
          full-time role (on-site or hybrid) in controls engineering, automation, or robotics in the
          Chattanooga area. If you have an opportunity you think I might be a good fit for, please
          reach out!
        </p>
        <p>
          Outside of work I enjoy tinkering with electronics, maintaining my{' '}
          <a href="/projects/homelab/">home server</a>, building websites, and working on
          open-source projects. I also enjoy mountain biking, rock climbing, and most things
          outdoors.
        </p>
      </div>
    </section>

    {featured.length > 0 && (
      <section class="section" aria-labelledby="featured">
        <SectionHeading index="02" id="featured" title="Featured work">
          <a class="label more" href="/projects/">
            All projects →
          </a>
        </SectionHeading>
        <ProjectGrid projects={featured} />
      </section>
    )}

    <section class="section" aria-labelledby="credentials">
      <SectionHeading index="03" id="credentials" title="Credentials">
        <a class="label more" href="/resume/#r-licenses">
          Full list on resume →
        </a>
      </SectionHeading>
      <Credentials />
    </section>

    <section class="section contact" aria-labelledby="contact">
      <SectionHeading index="04" id="contact" title="Contact" />
      <p class="contact-line">The best way to reach me is email.</p>
      <div class="contact-links">
        <ContactLinks />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-l);
    align-items: end;
    padding-block: var(--space-2xl) var(--space-xl);
  }
  @media (min-width: 52rem) {
    .hero.has-portrait {
      grid-template-columns: 1fr minmax(12rem, 20rem);
    }
  }
  .loc {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  h1 {
    font-size: var(--step-hero);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-block: var(--space-s) var(--space-m);
  }
  .headline {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
  .portrait {
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    filter: grayscale(0.15);
  }

  .section {
    margin-top: var(--space-xl);
  }
  .about {
    font-size: var(--step-0);
  }

  .more {
    text-decoration: none;
  }
  .more:hover {
    color: var(--accent);
  }

  .contact-line {
    font-size: var(--step-1);
    margin-bottom: var(--space-m);
  }
  .contact-links {
    max-width: 40rem;
  }
</style>
