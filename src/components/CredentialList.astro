---
/**
 * Licenses / certifications as rows: name + issuer on the left,
 * dates in a right-aligned mono column. "Expired" is judged at build time.
 */
import { formatMonth, datetimeAttr, hasPassed } from '../lib/resume';

interface Item {
  name: string;
  issuer?: string;
  issued?: string;
  expires?: string;
}
interface Props {
  items: Item[];
  /** Accessible name for the list, e.g. the group heading text. */
  label?: string;
}
const { items, label } = Astro.props;
---

<ul class="cred-list" role="list" aria-label={label}>
  {items.map((c) => {
    const expired = c.expires ? hasPassed(c.expires) : false;
    return (
      <li class="cred-row">
        <div class="what">
          <span class="name">{c.name}</span>
          {c.issuer && <span class="issuer">{c.issuer}</span>}
        </div>
        {(c.issued || c.expires) && (
          <div class="when label">
            {c.issued && (
              <span>
                <span class="visually-hidden">Issued </span>
                <time datetime={datetimeAttr(c.issued)}>{formatMonth(c.issued)}</time>
              </span>
            )}
            {c.expires && (
              <span class:list={['exp', { expired }]}>
                {expired ? 'Expired' : 'Expires'}{' '}
                <time datetime={datetimeAttr(c.expires)}>{formatMonth(c.expires)}</time>
              </span>
            )}
          </div>
        )}
      </li>
    );
  })}
</ul>

<style>
  .cred-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-m);
    align-items: baseline;
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
  }
  .what {
    display: flex;
    flex-direction: column;
  }
  .name {
    font-weight: 500;
  }
  .issuer {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    white-space: nowrap;
  }
  .exp {
    opacity: 0.8;
  }
  .expired {
    opacity: 0.6;
  }
  /* Narrow screens: dates drop under the issuer instead of squeezing the name. */
  @media (max-width: 34rem) {
    .cred-row {
      grid-template-columns: 1fr;
    }
    .when {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.75em;
      margin-top: 0.2rem;
      text-align: left;
    }
  }
</style>
