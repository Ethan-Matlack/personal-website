---
interface Props {
  /** Two-digit index shown as a spec-sheet label, e.g. "01". */
  index?: string;
  id: string;
  title: string;
}
const { index, id, title } = Astro.props;
---

<div class="section-heading">
  {index && (
    <span class="label" aria-hidden="true">
      {index}
    </span>
  )}
  <h2 id={id}>{title}</h2>
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    margin-bottom: var(--space-l);
  }
  h2 {
    font-size: var(--step-2);
    flex: 1;
  }
  .label {
    color: var(--accent);
    min-width: 2.5ch;
  }
</style>
