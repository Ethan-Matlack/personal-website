---
/**
 * Featured licenses + certifications (`featured: true` in resume.yaml),
 * read from the same data as the resume so they never disagree.
 */
import { resume } from '../lib/resume';
import CredentialList from './CredentialList.astro';

const licenses = resume.licenses.filter((l) => l.featured);
const certifications = resume.certifications.filter((c) => c.featured);
---

<div class="creds">
  <div class="col">
    <h3 class="label">Licenses</h3>
    <CredentialList items={licenses} label="Licenses" />
  </div>
  <div class="col">
    <h3 class="label">Certifications</h3>
    <CredentialList items={certifications} label="Certifications" />
  </div>
</div>

<style>
  .creds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-l) var(--space-xl);
    align-items: start;
  }
  h3 {
    font-weight: 450;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-s);
  }
</style>
