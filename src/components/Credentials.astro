---
/** Licenses + certifications, read from resume.yaml so they never disagree with the resume. */
import { resume } from '../lib/resume';
---

<dl class="creds">
  <div class="group">
    <dt class="label">Licenses</dt>
    {resume.licenses.map((l) => (
      <dd>
        <span class="name">{l.name}</span>
        <span class="meta">
          {l.issuer}
          {l.year && <>, {l.year}</>}
        </span>
      </dd>
    ))}
  </div>
  <div class="group">
    <dt class="label">Certifications</dt>
    {resume.certifications.map((c) => (
      <dd>
        <span class="name">{c}</span>
      </dd>
    ))}
  </div>
</dl>

<style>
  .creds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-l);
  }
  .group {
    display: flex;
    flex-direction: column;
  }
  dt {
    margin-bottom: var(--space-2xs);
  }
  dd {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-s);
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
  }
  dd:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .name {
    font-weight: 500;
  }
  .meta {
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
