---
import { site } from '../data/site';

interface Props {
  /** Show full email address as the link text (default) or just labels. */
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;

// Line icons (Lucide, ISC license), drawn with currentColor so they follow the text color.
const ICONS = {
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
} as const;

const links = [
  { label: 'Email', href: `mailto:${site.email}`, text: site.email, icon: ICONS.email },
  { label: 'LinkedIn', href: site.socials.linkedin, text: 'LinkedIn', icon: ICONS.linkedin },
  { label: 'GitHub', href: site.socials.github, text: 'GitHub', icon: ICONS.github },
];
---

<ul class:list={['contact', variant]} role="list">
  {links.map((l) => (
    <li>
      {variant === 'full' && <span class="label">{l.label}</span>}
      <a
        href={l.href}
        target={l.href.startsWith('http') ? '_blank' : undefined}
        rel={l.href.startsWith('http') ? 'me noopener' : undefined}
      >
        {variant === 'compact' && (
          <svg
            class="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={l.icon}
          />
        )}
        <span>{variant === 'full' ? l.text : l.label}</span>
        {l.href.startsWith('http') && <span class="visually-hidden"> (opens in a new tab)</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
  }
  .full {
    flex-direction: column;
  }
  .full li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: baseline;
    padding-block: var(--space-xs);
    border-top: 1px solid var(--rule);
  }
  .full li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .full a {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .compact a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--step--1);
  }
  .icon {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }
</style>
